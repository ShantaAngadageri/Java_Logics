package Logics_Numbers;

import java.util.Scanner;

public class Binary {
	public static void main(String[] args) {
		Scanner sc= new Scanner(System.in);
	    System.out.println("Enter a number");
	    int num=sc.nextInt();
	    String result=""; 
	    while(num!=0) {
	    	int rem=num%2;
	    	result=rem+result;
	    	num=num/2;
	    }
	    System.out.println(result);
		}
}
