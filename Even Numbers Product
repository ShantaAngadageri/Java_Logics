package Logics_Numbers;

import java.util.Scanner;

public class EvenProduct {
	public static void main(String[] args) {
	Scanner sc= new Scanner(System.in);
    System.out.println("Enter a number");
    int num=sc.nextInt();
    int prod=1; 
    while(num!=0) {
    	int rem=num%10;
    	if(rem%2==0) {
    		prod=prod*rem;
    	}
    	num=num/10;
    }
    System.out.println(prod);
	}
}
