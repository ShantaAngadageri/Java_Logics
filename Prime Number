package Logics;

public class Prime {
    static void Prime(int num)
    {
    	boolean flag=true;
    	for(int i=2;i<=Math.sqrt(num);i++) {
    		if(num%i==0) {
    			flag=false;
    			break;
    		}
    	}
    	if(flag) {
    		System.out.println("Prime");
    	}
    	else {
    		System.out.println("Not prime");
    	}
    	
    }
    public static void main(String[] args) {
    	Prime(7);
    	
    }
}
